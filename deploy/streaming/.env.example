# 复制为 .env 后按环境填写;密钥绝不写入仓库或配置文件
# SRS WebRTC candidate: 必须是浏览器能直达的宿主机 IP(局域网 IP 或公网 IP)
#   取值错误时 WHIP/WHEP 会协商到容器内网 IP,表现为"能连上但收不到流"
SRS_RTC_CANDIDATE=192.168.1.10
# LiveKit 开发密钥(与 livekit-cli / 未来控制面共用)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace_with_at_least_32_random_bytes
# 后端控制面注入(RTC-003,Spring relaxed binding):
#   RTC_LIVEKIT_API_KEY / RTC_LIVEKIT_API_SECRET / RTC_LIVEKIT_WEBHOOK_SECRET
#   webhook secret 必须与 LIVEKIT_API_SECRET 一致(LiveKit 用该 key 的 secret 签 webhook)
#   RTC_TOKEN_TTL_SECONDS=300 (60-900)
# coturn 临时凭据共享密钥(REST credentials 的 HMAC 密钥)
TURN_SHARED_SECRET=replace_with_at_least_32_random_bytes
# coturn relay UDP range. The development default is below the Windows dynamic range (49152+).
# Verify host exclusions before choosing a production range.
TURN_RELAY_MIN_PORT=40000
TURN_RELAY_MAX_PORT=40020
# coturn --external-ip 复用 SRS_RTC_CANDIDATE(浏览器可达的宿主机 IP)
# Grafana(monitoring profile)
GF_ADMIN_PASSWORD=replace_with_a_random_password
