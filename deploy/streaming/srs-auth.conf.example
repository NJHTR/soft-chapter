# RTC-006 production callback profile. Do not mount this file without setting
# SRS_CALLBACK_TOKEN and a private, host-reachable Spring URL.
# Merge these directives into vhost __defaultVhost__ in srs.conf; they are
# intentionally separate from the local smoke profile, which keeps auth off.

on_publish http://spring-control:9191/api/live/provider/srs/on_publish?callback_token=$SRS_CALLBACK_TOKEN;
on_unpublish http://spring-control:9191/api/live/provider/srs/on_unpublish?callback_token=$SRS_CALLBACK_TOKEN;
on_play http://spring-control:9191/api/live/provider/srs/on_play?callback_token=$SRS_CALLBACK_TOKEN;
on_stop http://spring-control:9191/api/live/provider/srs/on_stop?callback_token=$SRS_CALLBACK_TOKEN;
