# Copy to .env. Never commit the populated file.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=douyin
DB_PASSWORD=change-me-douyin
REDIS_PASSWORD=change-me-redis
JWT_SECRET=replace-with-a-long-random-secret
RTC_CALL_RINGING_TTL=180s
RTC_CALL_HISTORY_RETENTION=31d
KAFKA_LEDGER_RETENTION_HOURS=744
KAFKA_OUTBOX_RETENTION_HOURS=744
DOUYIN_KAFKA_ENABLED=true
RTC_API_PORT=9191
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=9092
RTC_NODE_ID=local-api
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Shanghai -Xms256m -Xmx768m -XX:+UseG1GC"
