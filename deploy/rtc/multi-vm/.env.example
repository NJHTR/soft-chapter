# Copy this file to .env on each VM. Never commit the populated file.
# Keep private infrastructure (DB/Redis/Kafka) on a private network.

# Role selected by deploy.sh: api, livekit, or turn.
ROLE=api
COMPOSE_PROJECT_NAME=douyin-rtc

# Optional edge role (run on the chosen entry VM, usually 192.168.59.128).
EDGE_IMAGE=caddy:2
EDGE_PORT=8080
API_UPSTREAMS="192.168.59.128:9191 192.168.59.129:9191 192.168.59.130:9191"
EDGE_CONFIG_PATH=./runtime/Caddyfile

# API image/build settings.
API_IMAGE=douyin-server:multi-vm
BUILD_API=true
API_BIND_ADDRESS=0.0.0.0
API_HOST_PORT=9191
API_CONTAINER_PORT=9191
API_MEMORY_LIMIT=900m
API_CPU_LIMIT=1.5
RTC_NODE_ID=vm-api-a
SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Shanghai -Xms256m -Xmx768m -XX:+UseG1GC"

# Shared control-plane dependencies. These are deliberately external to this stack.
DB_URL="jdbc:mysql://db.example.internal:3306/douyin?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai"
DB_USERNAME=douyin
DB_PASSWORD=replace-with-db-password
# In the validated VMware lab, Redis and Kafka run on the Windows host.
# Replace these two values when the shared dependencies live elsewhere.
REDIS_HOST=192.168.59.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
KAFKA_BOOTSTRAP_SERVERS=192.168.59.1:9092
DOUYIN_KAFKA_ENABLED=true

# Application secrets and shared RTC provider credentials.
JWT_SECRET=replace-with-a-long-random-secret
RTC_LIVEKIT_API_KEY=multi-vm-key
RTC_LIVEKIT_API_SECRET=replace-with-at-least-32-random-bytes
RTC_LIVEKIT_WEBHOOK_SECRET=replace-with-the-same-livekit-secret
RTC_TOKEN_TTL_SECONDS=300
WEBSOCKET_CLUSTER_ENABLED=true
WEBSOCKET_CLUSTER_CHANNEL=douyin:websocket:fanout:v1
WEBSOCKET_ALLOWED_ORIGINS=https://rtc.example.internal
RTC_CALL_RINGING_TTL=180s
RTC_CALL_HISTORY_RETENTION=31d
KAFKA_LEDGER_RETENTION_HOURS=744
KAFKA_OUTBOX_RETENTION_HOURS=744

# Optional media/control integration values.
SRS_RTC_PUBLIC_BASE=
SRS_HTTP_PUBLIC_BASE=
SRS_RTMP_PUBLIC_BASE=rtmp://192.168.59.128:1935/live/
LIVE_MEDIA_RECONCILIATION_ENABLED=false
SRS_API_BASE=http://192.168.59.128:1985
LIVE_MEDIA_AUTH_ENABLED=false
LIVE_MEDIA_TOKEN_SECRET=
SRS_CALLBACK_TOKEN=
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
DEEPSEEK_API_KEY=

# LiveKit role. NODE_IP is the VM address advertised to browsers.
NODE_IP=192.168.59.129
LIVEKIT_REGION=cn-east-1
# Must match RTC_LIVEKIT_API_KEY/RTC_LIVEKIT_API_SECRET above.
LIVEKIT_API_KEY=multi-vm-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-bytes
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_METRICS_PORT=7889
LIVEKIT_RTP_MIN_PORT=51000
LIVEKIT_RTP_MAX_PORT=51050
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_WEBHOOK_URL=http://192.168.59.128:9191/api/rtc/webhook/livekit
LIVEKIT_CONFIG_PATH=./runtime/livekit.yaml

# TURN role. TURN_EXTERNAL_IP may differ from NODE_IP behind NAT.
TURN_BIND_ADDRESS=0.0.0.0
TURN_HOST_PORT=3478
TURN_LISTENING_IP=192.168.59.129
TURN_RELAY_IP=192.168.59.129
TURN_EXTERNAL_IP=192.168.59.129
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_RELAY_MIN_PORT=41000
TURN_RELAY_MAX_PORT=41020
TURN_REALM=rtc.local
