# RTC-013 示例环境变量(复制为 .env 后填写;密钥绝不入库)
# Redis 共享路由认证(password 同时供节点注入 LIVEKIT_REDIS_PASSWORD)
REDIS_PASSWORD=replace_with_at_least_32_random_bytes
# LiveKit API 密钥(与单节点 dev 同源;生产隔离新 key)
LIVEKIT_API_KEY=cluster-key
LIVEKIT_API_SECRET=replace_with_at_least_32_random_bytes
# coturn REST 临时凭据共享密钥(HMAC)
TURN_SHARED_SECRET=replace_with_at_least_32_random_bytes
# coturn --external-ip:浏览器可达的宿主机 IP(局域网或公网)
SRS_RTC_CANDIDATE=192.168.1.10